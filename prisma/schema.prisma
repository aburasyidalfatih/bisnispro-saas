generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  domain               String?               @unique
  logo                 String?
  description          String?
  plan                 String                @default("free")
  theme                String                @default("aurora")
  template             String                @default("default")
  isActive             Boolean               @default(true)
  settings             Json?
  tagline              String?
  about                String?
  address              String?
  phone                String?
  email                String?
  website              String?
  whatsapp             String?
  instagram            String?
  facebook             String?
  youtube              String?
  tiktok               String?
  services             Json?
  heroImage            String?
  gallery              Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  affiliateId          String?
  expiresAt            DateTime?
  planId               String?
  seoDesc              String?
  seoTitle             String?
  studentQuota         Int                   @default(0)
  googleClientId       String?
  googleClientSecret   String?
  aiTokens             Int                   @default(0)
  useCustomApiKey      Boolean               @default(false)
  customOpenAiKey      String?
  achievements         Achievement[]
  affiliateCommissions AffiliateCommission[]
  alumni               Alumni[]
  auditLogs            AuditLog[]
  categories           Category[]
  contactSubmissions   ContactSubmission[]
  documents            Document[]
  dripLogs             DripLog[]
  events               Event[]
  extracurriculars     Extracurricular[]
  facilities           Facility[]
  invitations          Invitation[]
  notifications        Notification[]
  payments             Payment[]
  pendaftarPpdb        PendaftarPpdb[]
  periodePpdb          PeriodePpdb[]
  popups               Popup[]
  posts                Post[]
  programs             Program[]
  rekening             Rekening[]
  sliders              Slider[]
  staff                Staff[]
  students             Student[]
  classrooms           Classroom[]
  subscriptions        Subscription[]
  users                TenantUser[]
  internalMessages     InternalMessage[]
  waSession            WaSession?
  subscriptionPlan     SubscriptionPlan?     @relation(fields: [planId], references: [id])
  walletAccounts       WalletAccount[]
  walletTransactions   WalletTransaction[]
  cashflows            Cashflow[]
  billingTypes         BillingType[]
  invoices             Invoice[]
  invoicePayments      InvoicePayment[]
  installments         Installment[]
  canteenMerchants     CanteenMerchant[]
  canteenProducts      CanteenProduct[]
  canteenOrders        CanteenOrder[]
  canteenWithdrawals   CanteenWithdrawal[]
  attendanceSessions   AttendanceSession[]
  attendanceRecords    AttendanceRecord[]
  staffAttendances     StaffAttendance[]
  attendancePermits    AttendancePermit[]
  donationCampaigns    DonationCampaign[]
  donations            Donation[]
  subjects             Subject[]
  schedules            Schedule[]
  grades               Grade[]
  teacherJournals      TeacherJournal[]
  disciplineRecords    DisciplineRecord[]
  partnerships         Partnership[]
  websiteMenus         WebsiteMenu[]
  cbtExams             CbtExam[]
  cbtQuestionBanks     CbtQuestionBank[]
  aiUsageLogs          AiUsageLog[]
  tenantScore          TenantScore?
  waQueueLogs          WaQueueLog[]
  TenantNotification   TenantNotification[]

  customThemeId String?
  customTheme   CustomTheme? @relation(fields: [customThemeId], references: [id])

  @@index([isActive])
  @@index([plan])
  @@index([planId])
  @@index([createdAt])
  @@map("tenants")
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  password             String
  phone                String?
  avatar               String?
  emailVerified        DateTime?
  isActive             Boolean               @default(true)
  isSuperAdmin         Boolean               @default(false)
  twoFactorEnabled     Boolean               @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes Json?
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  affiliateProfile     AffiliateProfile?
  alumniProfiles       Alumni[]
  auditLogs            AuditLog[]
  documents            Document[]
  notificationSettings NotificationSetting[]
  notifications        Notification[]
  pendaftarPpdb        PendaftarPpdb[]
  posts                Post[]
  sessions             Session[]
  staffProfiles        Staff[]
  students             Student[]
  studentParents       StudentParent[]
  tenants              TenantUser[]
  verificationTokens   VerificationToken[]
  sentMessages         InternalMessage[]     @relation("MessageSender")
  receivedMessages     InternalMessage[]     @relation("MessageReceiver")
  canteenMerchant      CanteenMerchant?
  aiUsageLogs          AiUsageLog[]
  TenantNotification   TenantNotification[]

  @@index([isActive])
  @@index([isSuperAdmin])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  deviceName   String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("sessions")
}

model TenantUser {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  role     String @default("orangtua")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_users")
}

model Invitation {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      String   @default("orangtua")
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("invitations")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("verification_tokens")
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  title     String
  message   String
  type      String   @default("info")
  channel   String   @default("inapp")
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationSetting {
  id      String  @id @default(cuid())
  userId  String
  channel String
  enabled Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_settings")
}

model Payment {
  id                  String               @id @default(cuid())
  tenantId            String
  reference           String               @unique
  amount              Int
  method              String?
  status              String               @default("pending")
  plan                String
  tripayRef           String?
  paidAt              DateTime?
  expiredAt           DateTime?
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime? // Soft delete
  planId              String?
  affiliateCommission AffiliateCommission?
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription        Subscription?
  discountCodeId      String?
  discountCode        DiscountCode?        @relation(fields: [discountCodeId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([status, expiredAt])
  @@map("payments")
}

model DiscountCode {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  percentage  Float     @default(0)
  isActive    Boolean   @default(true)
  maxUses     Int?
  usedCount   Int       @default(0)
  bonusMonths Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments Payment[]

  @@index([createdAt])
  @@map("discount_codes")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@index([tenantId, entity])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model FileUpload {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  path      String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("file_uploads")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  ipAddress String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isRead])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("contact_submissions")
}

model PlatformSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("platform_settings")
}

model TenantApplication {
  id            String            @id @default(cuid())
  schoolName    String
  schoolSlug    String            @unique
  adminName     String
  adminEmail    String
  adminPhone    String
  adminPosition String?
  address       String?
  status        String            @default("PENDING")
  adminMessage  String?
  emailOpenedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  npsn          String?
  province      String?
  regency       String?
  schoolStatus  String?           @default("SWASTA")
  logo          String?
  studentCount  Int               @default(0)
  affiliateId   String?
  affiliate     AffiliateProfile? @relation(fields: [affiliateId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("tenant_applications")
}

model Post {
  id            String    @id @default(cuid())
  tenantId      String
  authorId      String
  title         String
  slug          String
  content       String
  featuredImage String?
  type          String    @default("BLOG_GURU")
  status        String    @default("PUBLISHED")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete
  seoDesc       String?
  seoTitle      String?
  categoryId    String?
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category      Category? @relation(fields: [categoryId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([authorId])
  @@index([categoryId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("posts")
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posts       Post[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("categories")
}

model Document {
  id          String   @id @default(cuid())
  tenantId    String
  uploaderId  String
  title       String
  description String?
  fileUrl     String
  mimeType    String
  size        Int
  type        String   @default("MATERI_TUGAS")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([uploaderId])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("documents")
}

model Event {
  id            String   @id @default(cuid())
  tenantId      String
  title         String
  description   String?
  location      String?
  contactPerson String?
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([startDate])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("events")
}

model Achievement {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?
  date        DateTime
  level       String   @default("LOKAL")
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("achievements")
}

model DripCampaign {
  id        String   @id @default(cuid())
  dayOffset Int      @unique
  title     String
  subject   String
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs DripLog[]

  @@index([createdAt])
  @@map("drip_campaigns")
}

model DripLog {
  id         String   @id @default(cuid())
  tenantId   String
  campaignId String
  sentAt     DateTime @default(now())

  isOpened Boolean   @default(false)
  openedAt DateTime?

  isClicked Boolean   @default(false)
  clickedAt DateTime?

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign DripCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([tenantId, campaignId])
  @@map("drip_logs")
}

model Facility {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  imageUrl    String?
  category    String?
  condition   String?
  access      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("facilities")
}

model Extracurricular {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  schedule        String?
  imageUrl        String?
  contactPerson   String?
  registrationUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("extracurriculars")
}

model Program {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  imageUrl    String?
  focus       String?
  prospects   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("programs")
}

model Alumni {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String?
  name            String
  graduationYear  Int
  currentStatus   String   @default("KULIAH")
  institutionName String?
  testimonial     String?
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("alumni")
}

model Staff {
  id              String             @id @default(cuid())
  tenantId        String
  name            String
  role            String
  imageUrl        String?
  bio             String?
  sortOrder       Int                @default(0)
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  email           String?
  phone           String?
  subject         String?
  education       String?
  instagram       String?
  facebook        String?
  tiktok          String?
  youtube         String?
  userId          String?
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?              @relation(fields: [userId], references: [id])
  classrooms      Classroom[]
  StaffAttendance StaffAttendance[]
  schedules       Schedule[]
  journals        TeacherJournal[]
  gradeInputs     Grade[]
  disciplines     DisciplineRecord[]
  cbtExams        CbtExam[]

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("staff")
}

model Popup {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  content     String?
  imageUrl    String?
  videoUrl    String?
  buttonText  String?
  buttonLink  String?
  isActive    Boolean  @default(false)
  displayOnce Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("popups")
}

model Slider {
  id         String   @id @default(cuid())
  tenantId   String
  title      String?
  subtitle   String?
  imageUrl   String
  buttonText String?
  buttonLink String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("sliders")
}

model SubscriptionPlan {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String?
  price         Float          @default(0)
  interval      String         @default("MONTHLY")
  features      Json?
  maxStudents   Int            @default(0)
  maxStorage    Int            @default(0)
  isActive      Boolean        @default(true)
  isPopular     Boolean        @default(false)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  tenants       Tenant[]

  @@index([createdAt])
  @@map("subscription_plans")
}

model Subscription {
  id        String           @id @default(cuid())
  tenantId  String
  planId    String
  paymentId String?          @unique
  status    String           @default("ACTIVE")
  startDate DateTime         @default(now())
  endDate   DateTime?
  amount    Float            @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  payment   Payment?         @relation(fields: [paymentId], references: [id])
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("subscriptions")
}

model PeriodePpdb {
  id           String              @id @default(cuid())
  tenantId     String
  nama         String
  tanggalBuka  DateTime
  tanggalTutup DateTime
  isActive     Boolean             @default(true)
  pengaturan   Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  pendaftar    PendaftarPpdb[]
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  persyaratan  PersyaratanBerkas[]

  @@index([tenantId])
  @@index([isActive])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("periode_ppdbs")
}

model PersyaratanBerkas {
  id        String       @id @default(cuid())
  periodeId String
  nama      String
  isWajib   Boolean      @default(true)
  tipeFile  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  berkas    BerkasPpdb[]
  periode   PeriodePpdb  @relation(fields: [periodeId], references: [id], onDelete: Cascade)

  @@index([periodeId])
  @@index([createdAt])
  @@map("persyaratan_berkas")
}

model PendaftarPpdb {
  id            String        @id @default(cuid())
  tenantId      String
  userId        String
  periodeId     String
  noPendaftaran String        @unique
  namaLengkap   String
  dataFormulir  Json?
  dataOrangtua  Json?
  status        String        @default("MENUNGGU")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  berkas        BerkasPpdb[]
  periode       PeriodePpdb   @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagihan       TagihanPpdb[]

  @@index([tenantId])
  @@index([userId])
  @@index([periodeId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, status])
  @@index([tenantId, periodeId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([dataFormulir], type: Gin)
  @@index([dataOrangtua], type: Gin)
  @@map("pendaftar_ppdbs")
}

model BerkasPpdb {
  id            String            @id @default(cuid())
  pendaftarId   String
  requirementId String
  fileUrl       String
  status        String            @default("MENUNGGU")
  catatan       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  pendaftar     PendaftarPpdb     @relation(fields: [pendaftarId], references: [id], onDelete: Cascade)
  requirement   PersyaratanBerkas @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([pendaftarId])
  @@index([requirementId])
  @@index([createdAt])
  @@map("berkas_ppdbs")
}

model TagihanPpdb {
  id          String           @id @default(cuid())
  pendaftarId String
  jenis       String
  nominal     Float
  items       Json?
  status      String           @default("BELUM_LUNAS")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  pembayaran  PembayaranPpdb[]
  pendaftar   PendaftarPpdb    @relation(fields: [pendaftarId], references: [id], onDelete: Cascade)

  @@index([pendaftarId])
  @@index([createdAt])
  @@map("tagihan_ppdbs")
}

model PembayaranPpdb {
  id        String      @id @default(cuid())
  tagihanId String
  nominal   Float
  buktiUrl  String?
  status    String      @default("PENDING")
  catatan   String?
  paidAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tagihan   TagihanPpdb @relation(fields: [tagihanId], references: [id], onDelete: Cascade)

  @@index([tagihanId])
  @@index([createdAt])
  @@map("pembayaran_ppdbs")
}

model Rekening {
  id            String   @id @default(cuid())
  tenantId      String
  namaBank      String
  nomorRekening String
  atasNama      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("rekenings")
}

model Student {
  id                String             @id @default(cuid())
  tenantId          String
  userId            String?
  noPendaftaran     String?
  nis               String?            @unique
  nisn              String?            @unique
  name              String
  gender            String?
  birthPlace        String?
  birthDate         DateTime?
  address           String?
  phone             String?
  email             String?
  fatherName        String?
  motherName        String?
  guardianName      String?
  metadata          Json?
  isActive          Boolean            @default(true)
  syncedAt          DateTime?
  classroomId       String?
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id])
  classroom         Classroom?         @relation(fields: [classroomId], references: [id])
  parents           StudentParent[]
  walletAccount     WalletAccount?
  invoices          Invoice[]
  canteenOrders     CanteenOrder[]
  attendanceRecords AttendanceRecord[]
  attendancePermits AttendancePermit[]
  grades            Grade[]
  journalPresences  JournalPresence[]
  disciplines       DisciplineRecord[]
  cbtSessions       CbtSession[]
  cbtAnswers        CbtAnswer[]

  @@index([tenantId])
  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("students")
}

model AffiliateProfile {
  id                 String                @id @default(cuid())
  userId             String                @unique
  referralCode       String                @unique
  bankName           String?
  bankAccount        String?
  accountName        String?
  balance            Int                   @default(0)
  totalEarnings      Int                   @default(0)
  clicks             Int                   @default(0)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  commissions        AffiliateCommission[]
  tenantApplications TenantApplication[]
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals        AffiliateWithdrawal[]

  @@index([createdAt])
  @@map("affiliate_profiles")
}

model AffiliateCommission {
  id          String           @id @default(cuid())
  affiliateId String
  tenantId    String
  paymentId   String           @unique
  amount      Int
  status      String           @default("PENDING")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  payment     Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("affiliate_commissions")
}

model AffiliateWithdrawal {
  id          String           @id @default(cuid())
  affiliateId String
  amount      Int
  status      String           @default("PENDING")
  bankName    String?
  bankAccount String?
  accountName String?
  notes       String?
  receiptUrl  String?
  processedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
  @@map("affiliate_withdrawals")
}

model WaSession {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  status    String   @default("DISCONNECTED") // DISCONNECTED, CONNECTED, CONNECTING
  qrCode    String?  @db.Text // Base64 image
  creds     Json? // Baileys auth state
  delayMin  Int      @default(5)
  delayMax  Int      @default(15)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("wa_sessions")
}

model Classroom {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  level       String?
  capacity    Int      @default(30)
  waliKelasId String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waliKelas          Staff?              @relation(fields: [waliKelasId], references: [id])
  students           Student[]
  attendanceSessions AttendanceSession[]
  schedules          Schedule[]
  journals           TeacherJournal[]
  grades             Grade[]

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("classrooms")
}

model StudentParent {
  id        String   @id @default(cuid())
  studentId String
  userId    String
  relation  String   @default("AYAH") // AYAH, IBU, WALI
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studentId, userId])
  @@index([studentId])
  @@index([userId])
  @@index([createdAt])
  @@map("student_parents")
}

model WaMessage {
  id        String   @id @default(cuid())
  tenantId  String
  to        String
  content   String   @db.Text
  status    String   @default("PENDING") // PENDING, SENT, FAILED
  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tidak perlu strict relation ke Tenant agar jika tenant dihapus log tidak hilang (atau bisa diatur Cascade)
  // Tapi untuk konsistensi kita tambahkan index saja
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("wa_messages")
}

// ----------------------------------------------------------------------
// EPIC 1: SchoolPay Wallet & Cashflow
// ----------------------------------------------------------------------

model WalletAccount {
  id         String   @id @default(cuid())
  tenantId   String
  studentId  String   @unique
  balance    Float    @default(0)
  pin        String? // 6-digit PIN untuk transaksi
  dailyLimit Float? // Limit batas jajan harian
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("wallet_accounts")
}

model WalletTransaction {
  id            String   @id @default(cuid())
  walletId      String
  tenantId      String
  type          String // DEPOSIT, WITHDRAWAL, PAYMENT, TRANSFER
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  referenceId   String? // ID referensi eksternal (Invoice, dll)
  description   String?
  status        String   @default("SUCCESS") // PENDING, SUCCESS, FAILED
  metadata      Json?
  createdAt     DateTime @default(now())

  wallet WalletAccount @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model Cashflow {
  id          String   @id @default(cuid())
  tenantId    String
  type        String // INCOME, EXPENSE
  category    String // SPP, KANTIN, DONASI, OPERASIONAL, dll
  amount      Float
  description String?
  referenceId String? // ID relasi (Invoice/Payment)
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([type])
  @@index([category])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("cashflows")
}

model InternalMessage {
  id         String   @id @default(cuid())
  tenantId   String
  senderId   String
  receiverId String? // Jika null, berarti pesan broadcast/untuk Admin
  subject    String?
  body       String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User?  @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("internal_messages")
}

// ======================================================================
// EPIC 2: BILLING & AUTO-DEBET SPP
// ======================================================================

// Jenis tagihan yang bisa dibuat sekolah (template)
model BillingType {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // "SPP", "Uang Gedung", "Seragam", dll
  category    String   @default("SPP") // SPP, DAFTAR_ULANG, SERAGAM, BEBAS, LAINNYA
  amount      Float
  isRecurring Boolean  @default(false) // Jika true → Auto-Bill tiap bulan
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("billing_types")
}

// Tagihan siswa (1 tagihan per siswa per periode)
model Invoice {
  id            String    @id @default(cuid())
  tenantId      String
  studentId     String
  billingTypeId String?
  code          String    @unique // INV-2024-07-0001
  title         String
  amount        Float
  amountPaid    Float     @default(0)
  amountDue     Float // amount - amountPaid
  dueDate       DateTime
  month         Int? // 1-12, untuk SPP bulanan
  year          Int?
  status        String    @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE, CANCELLED
  isAutoDebet   Boolean   @default(false) // Apakah didebet dari wallet otomatis?
  notes         String?
  deletedAt     DateTime? // Soft delete
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  billingType  BillingType?     @relation(fields: [billingTypeId], references: [id])
  payments     InvoicePayment[]
  installments Installment[]

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, studentId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("invoices")
}

// Pembayaran atas tagihan (bisa via Tripay, manual, atau Wallet)
model InvoicePayment {
  id         String    @id @default(cuid())
  invoiceId  String
  tenantId   String
  amount     Float
  method     String // WALLET, TRANSFER, CASH, TRIPAY
  reference  String? // ID transaksi eksternal (Tripay ref, dsb)
  proofUrl   String? // Bukti transfer manual
  status     String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  verifiedAt DateTime?
  verifiedBy String? // userId admin yang verifikasi
  notes      String?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("invoice_payments")
}

// Cicilan tagihan besar
model Installment {
  id        String    @id @default(cuid())
  invoiceId String
  tenantId  String
  dueDate   DateTime
  amount    Float
  status    String    @default("UNPAID") // UNPAID, PAID
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("installments")
}

// ======================================================================
// EPIC 3: E-KANTIN (CASHLESS CANTEEN)
// ======================================================================

// Merchant / Pedagang Kantin
model CanteenMerchant {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String   @unique // Akun login si pedagang
  name        String // "Warung Bu Siti"
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  balance     Float    @default(0) // Saldo kantin (pending withdrawal)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id])
  products    CanteenProduct[]
  orders      CanteenOrder[]
  withdrawals CanteenWithdrawal[]

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("canteen_merchants")
}

// Menu / Produk Kantin
model CanteenProduct {
  id          String   @id @default(cuid())
  merchantId  String
  tenantId    String
  name        String
  description String?
  imageUrl    String?
  price       Float
  stock       Int      @default(-1) // -1 = unlimited
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant   CanteenMerchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems CanteenOrderItem[]

  @@index([merchantId])
  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("canteen_products")
}

// Transaksi jual-beli di kantin
model CanteenOrder {
  id          String   @id @default(cuid())
  tenantId    String
  merchantId  String
  studentId   String // Siswa yang membeli
  total       Float
  status      String   @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  pinVerified Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  merchant CanteenMerchant    @relation(fields: [merchantId], references: [id])
  student  Student            @relation(fields: [studentId], references: [id])
  items    CanteenOrderItem[]

  @@index([tenantId])
  @@index([merchantId])
  @@index([studentId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("canteen_orders")
}

model CanteenOrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  name      String // Snapshot nama produk saat transaksi
  price     Float
  quantity  Int
  subtotal  Float

  order   CanteenOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product CanteenProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("canteen_order_items")
}

// Penarikan dana merchant ke sekolah
model CanteenWithdrawal {
  id          String    @id @default(cuid())
  tenantId    String
  merchantId  String
  amount      Float
  status      String    @default("PENDING") // PENDING, PROCESSED, REJECTED
  notes       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  merchant CanteenMerchant @relation(fields: [merchantId], references: [id])

  @@index([tenantId])
  @@index([merchantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("canteen_withdrawals")
}

// ======================================================================
// EPIC 4: ABSENSI & DISIPLIN
// ======================================================================

// Sesi Absensi Harian (dibuat per hari oleh admin/guru)
model AttendanceSession {
  id          String   @id @default(cuid())
  tenantId    String
  classroomId String?
  date        DateTime @db.Date
  type        String   @default("DAILY") // DAILY, EXAM, EXTRACURRICULAR
  createdBy   String
  createdAt   DateTime @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classroom Classroom?         @relation(fields: [classroomId], references: [id])
  records   AttendanceRecord[]

  @@unique([tenantId, classroomId, date])
  @@index([tenantId])
  @@index([date])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("attendance_sessions")
}

// Rekaman absensi per-siswa
model AttendanceRecord {
  id           String    @id @default(cuid())
  sessionId    String
  tenantId     String
  studentId    String
  academicYear String? // Untuk partitioning
  status       String // HADIR, IZIN, SAKIT, ALPHA
  notes        String?
  checkinAt    DateTime?
  proofUrl     String? // Foto/surat keterangan
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft delete

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id])
  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([tenantId])
  @@index([studentId])
  @@index([createdAt])
  @@index([tenantId, academicYear])
  @@index([tenantId, createdAt])
  @@map("attendance_records")
}

// Absensi Guru/Staf dengan Check-In/Out + GPS
model StaffAttendance {
  id           String    @id @default(cuid())
  tenantId     String
  staffId      String
  date         DateTime  @db.Date
  checkInAt    DateTime?
  checkOutAt   DateTime?
  checkInLat   Float?
  checkInLng   Float?
  checkInPhoto String?
  status       String    @default("HADIR") // HADIR, IZIN, SAKIT, ALPHA
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft delete

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id])

  @@unique([tenantId, staffId, date])
  @@index([tenantId])
  @@index([staffId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("staff_attendances")
}

// Pengajuan Izin/Sakit dari Orang Tua
model AttendancePermit {
  id          String    @id @default(cuid())
  tenantId    String
  studentId   String
  submittedBy String // userId ortu
  type        String // IZIN, SAKIT
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  reason      String
  proofUrl    String?
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("attendance_permits")
}

// ======================================================================
// EPIC 5: CROWDFUNDING & DONASI
// ======================================================================

model DonationCampaign {
  id              String    @id @default(cuid())
  tenantId        String
  title           String
  description     String?   @db.Text
  imageUrl        String?
  targetAmount    Float
  collectedAmount Float     @default(0)
  startDate       DateTime
  endDate         DateTime?
  isPublic        Boolean   @default(true) // Bisa diakses tanpa login
  isActive        Boolean   @default(true)
  slug            String? // Untuk URL publik
  deletedAt       DateTime? // Soft delete
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donations Donation[]

  @@index([tenantId])
  @@index([isActive])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("donation_campaigns")
}

model Donation {
  id          String    @id @default(cuid())
  campaignId  String
  tenantId    String
  donorName   String // Bisa anonymous
  donorEmail  String?
  userId      String? // Jika login → otomatis isi
  amount      Float
  method      String // WALLET, TRIPAY
  reference   String? // ID transaksi Tripay
  isAnonymous Boolean   @default(false)
  message     String?
  status      String    @default("PENDING") // PENDING, PAID
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  campaign DonationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("donations")
}

// ======================================================================
// EPIC 6: AKADEMIK — MAPEL, JADWAL, NILAI, JURNAL, DISIPLIN
// ======================================================================

// Mata Pelajaran (Master Data per Tenant)
model Subject {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedules Schedule[]
  grades    Grade[]
  journals  TeacherJournal[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("subjects")
}

// Jadwal Pelajaran Mingguan (Roster)
model Schedule {
  id          String   @id @default(cuid())
  tenantId    String
  classroomId String
  subjectId   String
  staffId     String
  dayOfWeek   Int // 1=Senin, 2=Selasa, ..., 6=Sabtu
  startTime   String // "07:00"
  endTime     String // "08:30"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([classroomId])
  @@index([staffId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("schedules")
}

// Penilaian / Nilai Siswa
model Grade {
  id          String   @id @default(cuid())
  tenantId    String
  studentId   String
  subjectId   String
  classroomId String
  staffId     String
  type        String // HARIAN, PTS, PAS, PRAKTEK
  semester    Int // 1 atau 2
  year        Int // Tahun ajaran (misal 2024)
  score       Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  staff     Staff     @relation(fields: [staffId], references: [id])

  @@unique([tenantId, studentId, subjectId, type, semester, year])
  @@index([tenantId])
  @@index([studentId])
  @@index([classroomId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("grades")
}

// Jurnal Mengajar Guru (per hari per kelas per mapel)
model TeacherJournal {
  id          String   @id @default(cuid())
  tenantId    String
  staffId     String
  classroomId String
  subjectId   String
  date        DateTime @db.Date
  topic       String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     Staff             @relation(fields: [staffId], references: [id])
  classroom Classroom         @relation(fields: [classroomId], references: [id])
  subject   Subject           @relation(fields: [subjectId], references: [id])
  presences JournalPresence[]

  @@unique([staffId, classroomId, subjectId, date])
  @@index([tenantId])
  @@index([staffId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("teacher_journals")
}

// Presensi Siswa di dalam Jurnal Guru
model JournalPresence {
  id        String  @id @default(cuid())
  journalId String
  studentId String
  status    String // HADIR, IZIN, SAKIT, ALPHA
  notes     String?

  journal TeacherJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id])

  @@unique([journalId, studentId])
  @@index([journalId])
  @@map("journal_presences")
}

// Catatan Pelanggaran & Penghargaan Siswa (BK)
model DisciplineRecord {
  id          String   @id @default(cuid())
  tenantId    String
  studentId   String
  staffId     String
  type        String // PELANGGARAN, PENGHARGAAN
  category    String // KEDISIPLINAN, AKADEMIK, ATRIBUT, PERILAKU
  description String
  points      Int      @default(0)
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("discipline_records")
}

model Partnership {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  imageUrl   String
  websiteUrl String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("partnerships")
}

// ======================================================================
// EPIC 4: CBT (COMPUTER BASED TEST)
// ======================================================================

model CbtQuestionBank {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  level       String? // SD, SMP, SMA, KELAS_10, dll
  subject     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questions CbtQuestion[]
  exams     CbtExam[]

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("cbt_question_banks")
}

model CbtQuestion {
  id             String   @id @default(cuid())
  questionBankId String
  type           String   @default("MULTIPLE_CHOICE") // MULTIPLE_CHOICE, ESSAY
  content        String   @db.Text
  options        Json? // Array of objects { id, text, isCorrect }
  explanation    String?  @db.Text
  points         Int      @default(1)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  questionBank CbtQuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  answers      CbtAnswer[]

  @@index([questionBankId])
  @@map("cbt_questions")
}

model CbtExam {
  id             String   @id @default(cuid())
  tenantId       String
  questionBankId String
  authorId       String // ID Guru/Staff yang membuat
  title          String
  description    String?
  type           String   @default("UTS") // UTS, UAS, KUIS, TUGAS
  startTime      DateTime
  endTime        DateTime
  duration       Int // Durasi ujian dalam menit
  passingGrade   Int      @default(0)
  randomize      Boolean  @default(true) // Acak urutan soal
  randomizeOpts  Boolean  @default(true) // Acak urutan opsi jawaban (A,B,C,D)
  showResult     Boolean  @default(false)
  pin            String? // PIN Opsional untuk masuk ujian
  status         String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questionBank CbtQuestionBank @relation(fields: [questionBankId], references: [id])
  author       Staff           @relation(fields: [authorId], references: [id])
  sessions     CbtSession[]

  @@index([tenantId])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("cbt_exams")
}

model CbtSession {
  id         String    @id @default(cuid())
  examId     String
  studentId  String
  status     String    @default("ONGOING") // ONGOING, FINISHED, BLOCKED
  startTime  DateTime  @default(now())
  endTime    DateTime?
  score      Float?
  ipAddress  String?
  userAgent  String?
  cheatCount Int       @default(0) // Berapa kali terdeteksi pindah tab
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  exam    CbtExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers CbtAnswer[]

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@map("cbt_sessions")
}

model CbtAnswer {
  id         String   @id @default(cuid())
  sessionId  String
  studentId  String
  questionId String
  answer     String?  @db.Text // Bisa ID opsi ganda, atau teks essay
  isCorrect  Boolean  @default(false)
  points     Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session  CbtSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student  Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question CbtQuestion @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@index([studentId])
  @@index([sessionId])
  @@index([questionId])
  @@index([createdAt])
  @@map("cbt_answers")
}

model AiUsageLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  feature   String
  tokens    Int
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("ai_usage_logs")
}

// Leaderboard Tracking Score
model TenantScore {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  contentScore   Int      @default(0) // Posts, Staff, Facilities, etc.
  trafficScore   Int      @default(0) // PageViews or Unique Visitors
  activityScore  Int      @default(0) // Admin logins, etc.
  totalScore     Int      @default(0)
  rank           Int      @default(0)
  lastCalculated DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([totalScore(sort: Desc)])
  @@index([rank])
  @@map("tenant_scores")
}

model WaQueueLog {
  id           String    @id @default(cuid())
  tenantId     String?
  targetNumber String
  message      String    @db.Text
  status       String    @default("PENDING") // PENDING, SENT, FAILED
  error        String?   @db.Text
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("wa_queue_logs")
}

model TenantNotification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String? // Opsional, jika spesifik untuk 1 user
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, POINTS_UP
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("tenant_notifications")
}

model CustomTheme {
  id        String  @id @default(cuid())
  name      String
  author    String?
  version   String  @default("1.0.0")
  thumbnail String?

  layoutHtml          String  @db.Text
  indexHtml           String  @db.Text
  facilityHtml        String? @db.Text
  aboutHtml           String? @db.Text
  staffHtml           String? @db.Text
  newsHtml            String? @db.Text
  newsDetailHtml      String? @db.Text
  galleryHtml         String? @db.Text
  contactHtml         String? @db.Text
  extracurricularHtml String? @db.Text
  programHtml         String? @db.Text
  achievementHtml     String? @db.Text
  customCss           String  @db.Text
  customJs            String  @db.Text

  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants Tenant[]

  @@map("custom_themes")
}

model WebsiteMenu {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  label String
  url   String
  icon  String? // Optional lucide icon name

  parentId String?
  parent   WebsiteMenu?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children WebsiteMenu[] @relation("MenuHierarchy")

  order    Int     @default(0)
  isActive Boolean @default(true)
  isSystem Boolean @default(false) // Jika true, menu bawaan seperti Home tidak bisa dihapus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([parentId])
  @@map("website_menus")
}
