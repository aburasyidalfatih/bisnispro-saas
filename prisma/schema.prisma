  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  staff       Staff     @relation(fields: [staffId], references: [id])
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, subjectId, type, semester, year])
  @@index([tenantId, studentId, year, semester])
  @@index([classroomId])
  @@index([createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("grades")
}

model TeacherJournal {
  id          String            @id @default(cuid())
  tenantId    String
  staffId     String
  classroomId String
  subjectId   String
  date        DateTime          @db.Date
  topic       String
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  presences   JournalPresence[]
  classroom   Classroom         @relation(fields: [classroomId], references: [id])
  staff       Staff             @relation(fields: [staffId], references: [id])
  subject     Subject           @relation(fields: [subjectId], references: [id])
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([staffId, classroomId, subjectId, date])
  @@index([tenantId])
  @@index([staffId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("teacher_journals")
}

model JournalPresence {
  id        String         @id @default(cuid())
  journalId String
  studentId String
  status    String
  notes     String?
  journal   TeacherJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  student   Student        @relation(fields: [studentId], references: [id])

  @@unique([journalId, studentId])
  @@index([journalId])
  @@map("journal_presences")
}

model DisciplineRecord {
  id          String    @id @default(cuid())
  tenantId    String
  studentId   String
  staffId     String
  type        String
  category    String
  description String
  points      Int       @default(0)
  date        DateTime  @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  staff       Staff     @relation(fields: [staffId], references: [id])
  student     Student   @relation(fields: [studentId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("discipline_records")
}

model Partnership {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  imageUrl   String
  websiteUrl String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("partnerships")
}

model CbtQuestionBank {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  description String?
  level       String?
  subject     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  exams       CbtExam[]
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questions   CbtQuestion[]

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("cbt_question_banks")
}

model CbtQuestion {
  id             String          @id @default(cuid())
  questionBankId String
  type           String          @default("MULTIPLE_CHOICE")
  content        String
  options        Json?
  explanation    String?
  points         Int             @default(1)
  order          Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  answers        CbtAnswer[]
  questionBank   CbtQuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)

  @@index([questionBankId])
  @@map("cbt_questions")
}

model CbtExam {
  id             String          @id @default(cuid())
  tenantId       String
  questionBankId String
  authorId       String
  title          String
  description    String?
  type           String          @default("UTS")
  startTime      DateTime
  endTime        DateTime
  duration       Int
  passingGrade   Int             @default(0)
  randomize      Boolean         @default(true)
  randomizeOpts  Boolean         @default(true)
  showResult     Boolean         @default(false)
  pin            String?
  status         String          @default("DRAFT")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  author         Staff           @relation(fields: [authorId], references: [id])
  questionBank   CbtQuestionBank @relation(fields: [questionBankId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions       CbtSession[]

  @@index([tenantId])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("cbt_exams")
}

model CbtSession {
  id         String      @id @default(cuid())
  examId     String
  studentId  String
  status     String      @default("ONGOING")
  startTime  DateTime    @default(now())
  endTime    DateTime?
  score      Float?
  ipAddress  String?
  userAgent  String?
  cheatCount Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  answers    CbtAnswer[]
  exam       CbtExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId, status])
  @@index([createdAt(sort: Desc)])
  @@map("cbt_sessions")
}

model CbtAnswer {
  id         String      @id @default(cuid())
  sessionId  String
  studentId  String
  questionId String
  answer     String?
  isCorrect  Boolean     @default(false)
  points     Float       @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  question   CbtQuestion @relation(fields: [questionId], references: [id])
  session    CbtSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([sessionId])
  @@index([questionId])
  @@map("cbt_answers")
}

model AiUsageLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  feature   String
  tokens    Int
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("ai_usage_logs")
}

model AiTokenPackage {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float    @default(0)
  tokens      Int      @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ai_token_packages")
}

model TenantScore {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  contentScore   Int      @default(0)
  trafficScore   Int      @default(0)
  activityScore  Int      @default(0)
  totalScore     Int      @default(0)
  rank           Int      @default(0)
  lastCalculated DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([totalScore(sort: Desc)])
  @@index([rank])
  @@map("tenant_scores")
}

model WaQueueLog {
  id           String    @id @default(cuid())
  tenantId     String?
  targetNumber String
  message      String
  status       String    @default("PENDING")
  error        String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("wa_queue_logs")
}

model TenantNotification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("tenant_notifications")
}

model CustomTheme {
  id                   String   @id @default(cuid())
  name                 String
  author               String?
  version              String   @default("1.0.0")
  thumbnail            String?
  layoutHtml           String
  indexHtml            String
  facilityHtml         String?
  customCss            String
  customJs             String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  aboutHtml            String?
  achievementHtml      String?
  contactHtml          String?
  extracurricularHtml  String?
  galleryHtml          String?
  newsDetailHtml       String?
  newsHtml             String?
  programHtml          String?
  staffHtml            String?
  isActive             Boolean  @default(true)
  // New template columns
  pengumumanHtml       String?
  pengumumanDetailHtml String?
  ppdbHtml             String?
  alumniHtml           String?
  agendaHtml           String?
  unduhanHtml          String?
