model WebsiteMenu {
  id        String        @id @default(cuid())
  tenantId  String
  label     String
  url       String
  icon      String?
  parentId  String?
  order     Int           @default(0)
  isActive  Boolean       @default(true)
  isSystem  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  parent    WebsiteMenu?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children  WebsiteMenu[] @relation("MenuHierarchy")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([parentId])
  @@map("website_menus")
}
