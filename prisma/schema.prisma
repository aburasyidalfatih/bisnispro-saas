generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  domain                 String?                 @unique
  logo                   String?
  description            String?
  plan                   String                  @default("free")
  theme                  String                  @default("aurora")
  isActive               Boolean                 @default(true)
  lastActiveAt           DateTime                @default(now())
  retentionStatus        String                  @default("ACTIVE")
  deletedAt              DateTime?
  settings               Json?
  tagline                String?
  about                  String?
  address                String?
  phone                  String?
  email                  String?
  website                String?
  whatsapp               String?
  instagram              String?
  facebook               String?
  youtube                String?
  tiktok                 String?
  telegram               String?
  heroImage              String?
  gallery                Json?
  galleryImages          TenantGallery[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  affiliateId            String?
  expiresAt              DateTime?
  planId                 String?
  seoDesc                String?
  seoTitle               String?
  employeeCount          Int                     @default(0)
  businessType           String                  @default("UMKM")
  nib                    String?
  operatingHours         Json?
  foundedYear            Int?
  mapLatitude            Float?
  mapLongitude           Float?
  googleClientId         String?
  googleClientSecret     String?
  aiTokens               Int                     @default(0)
  aiAddonTokens          Int                     @default(0)
  template               String                  @default("default")
  customThemeId          String?
  portfolios             Portfolio[]
  affiliateCommissions   AffiliateCommission[]
  aiUsageLogs            AiUsageLog[]
  testimonials           Testimonial[]
  auditLogs              AuditLog[]
  categories             Category[]
  contactSubmissions     ContactSubmission[]
  documents              Document[]
  donationCampaigns      DonationCampaign[]
  donations              Donation[]
  dripLogs               DripLog[]
  events                 Event[]
  offices                Office[]
  internalMessages       InternalMessage[]
  invitations            Invitation[]
  notifications          Notification[]
  partnerships           Partnership[]
  payments               Payment[]
  popups                 Popup[]
  posts                  Post[]
  services               Service[]
  sliders                Slider[]
  teamMembers            TeamMember[]
  emailQueueLogs         EmailQueueLog[]
  subscriptions          Subscription[]
  TenantNotification     TenantNotification[]
  tenantScore            TenantScore?
  users                  TenantUser[]
  customTheme            CustomTheme?            @relation(fields: [customThemeId], references: [id])
  subscriptionPlan       SubscriptionPlan?       @relation(fields: [planId], references: [id])
  waQueueLogs            WaQueueLog[]
  socialMediaCredentials SocialMediaCredential[]

  websiteMenus      WebsiteMenu[]
  customPages       CustomPage[]
  faqs              Faq[]
  pageViews         PageView[]
  errorLogs         ErrorLog[]
  systemFeedbacks   SystemFeedback[]
  courseEnrollments CourseEnrollment[]

  discountCodes DiscountCode[]

  @@index([isActive])
  @@index([plan])
  @@index([planId])
  @@index([template])
  @@index([customThemeId])
  @@index([createdAt])
  @@map("tenants")
}

model TenantGallery {
  id          String   @id @default(cuid())
  tenantId    String
  imageUrl    String
  imageAlt    String?
  title       String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, sortOrder])
  @@map("tenant_galleries")
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  password             String
  phone                String?
  avatar               String?
  bio                  String?               @db.Text
  emailVerified        DateTime?
  isActive             Boolean               @default(true)
  isSuperAdmin         Boolean               @default(false)
  twoFactorEnabled     Boolean               @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  affiliateProfile     AffiliateProfile?
  aiUsageLogs          AiUsageLog[]
  auditLogs            AuditLog[]
  documents            Document[]
  receivedMessages     InternalMessage[]     @relation("MessageReceiver")
  sentMessages         InternalMessage[]     @relation("MessageSender")
  notificationSettings NotificationSetting[]
  notifications        Notification[]
  posts                Post[]
  sessions             Session[]
  TenantNotification   TenantNotification[]
  tenants              TenantUser[]
  verificationTokens   VerificationToken[]
  aiTokens             Int                   @default(0)
  aiChatSessions       AiChatSession[]
  errorLogs            ErrorLog[]
  systemFeedbacks      SystemFeedback[]
  coursesCreated       Course[]              @relation("CourseAuthor")
  courseEnrollments    CourseEnrollment[]
  postComments         PostComment[]
  postInteractions     PostInteraction[]

  @@index([isActive])
  @@index([isSuperAdmin])
  @@index([createdAt])
  @@map("users")
}

model AiChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_chat_sessions")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  deviceName   String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("sessions")
}

model TenantUser {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  role     String @default("STAFF")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_users")
}

model Invitation {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      String   @default("STAFF")
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("invitations")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("verification_tokens")
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  title     String
  message   String
  type      String   @default("info")
  channel   String   @default("inapp")
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, isRead])
  @@map("notifications")
}

model NotificationSetting {
  id      String  @id @default(cuid())
  userId  String
  channel String
  enabled Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_settings")
}

model Payment {
  id                   String                @id @default(cuid())
  tenantId             String
  reference            String                @unique
  amount               Int
  method               String?
  status               String                @default("pending")
  plan                 String
  tripayRef            String?
  paidAt               DateTime?
  expiredAt            DateTime?
  metadata             Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  planId               String?
  discountCodeId       String?
  deletedAt            DateTime?
  affiliateCommissions AffiliateCommission[]
  discountCode         DiscountCode?         @relation(fields: [discountCodeId], references: [id])
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription         Subscription?
  courseId             String?
  course               Course?               @relation(fields: [courseId], references: [id])

  @@index([createdAt])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([status, expiredAt])
  @@index([discountCodeId])
  @@index([courseId])
  @@map("payments")
}

model DiscountCode {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  type           String    @default("DISCOUNT") // "DISCOUNT" atau "CASHBACK"
  percentage     Float     @default(0)
  cashbackAmount Int       @default(0)
  isActive       Boolean   @default(true)
  maxUses        Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bonusMonths    Int       @default(0)
  affiliateId    String?
  linkedTenantId String?

  payments     Payment[]
  affiliate    AffiliateProfile? @relation(fields: [affiliateId], references: [id])
  linkedTenant Tenant?           @relation(fields: [linkedTenantId], references: [id])

  @@index([createdAt])
  @@index([affiliateId])
  @@index([linkedTenantId])
  @@map("discount_codes")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@index([tenantId, entity])
  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model ErrorLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  category   String   @default("SYSTEM_BUG")
  message    String
  stack      String?
  path       String?
  method     String?
  metadata   Json?
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([isResolved])
  @@index([tenantId, createdAt])
  @@map("error_logs")
}

model FileUpload {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  path      String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("file_uploads")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  ipAddress String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isRead])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("contact_submissions")
}

model PlatformSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("platform_settings")
}

model TenantApplication {
  id             String            @id @default(cuid())
  businessName   String
  businessSlug   String            @unique
  adminName      String
  adminEmail     String
  adminPhone     String
  adminPosition  String?
  address        String?
  status         String            @default("PENDING")
  adminMessage   String?
  hashedPassword String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  province       String?
  regency        String?
  businessType   String?           @default("UMKM")
  logo           String?
  employeeCount  Int               @default(0)
  affiliateId    String?
  emailOpenedAt  DateTime?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  affiliate      AffiliateProfile? @relation(fields: [affiliateId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([utmSource])
  @@index([utmCampaign])
  @@map("tenant_applications")
}

model Post {
  id                  String            @id @default(cuid())
  tenantId            String
  authorId            String
  title               String
  slug                String
  content             String
  featuredImage       String?
  imageAlt            String?
  type                String            @default("BLOG_GURU")
  status              String            @default("PUBLISHED")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  publishedAt         DateTime?
  seoDesc             String?
  seoTitle            String?
  categoryId          String?
  deletedAt           DateTime?
  viewCount           Int               @default(0)
  shareCount          Int               @default(0)
  points              Int               @default(20)
  isEligibleForPoints Boolean           @default(true)
  author              User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category            Category?         @relation(fields: [categoryId], references: [id])
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comments            PostComment[]
  interactions        PostInteraction[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([authorId])
  @@index([categoryId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("posts")
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posts       Post[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("categories")
}

model Document {
  id          String   @id @default(cuid())
  tenantId    String
  uploaderId  String
  title       String
  description String?
  fileUrl     String
  mimeType    String
  size        Int
  type        String   @default("DOCUMENT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([uploaderId])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("documents")
}

model Event {
  id            String    @id @default(cuid())
  tenantId      String
  title         String
  slug          String
  description   String?
  location      String?
  contactPerson String?
  startDate     DateTime
  endDate       DateTime
  status        String    @default("PUBLISHED")
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  viewCount     Int       @default(0)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([startDate])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("events")
}

model Portfolio {
  id           String   @id @default(cuid())
  tenantId     String
  title        String
  slug         String
  description  String?
  completedAt  DateTime
  clientName   String   @default("LOKAL")
  category     String   @default("SISWA")
  imageUrl     String?
  projectUrl   String?
  technologies Json?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([category])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("portfolios")
}

model DripCampaign {
  id        String    @id @default(cuid())
  dayOffset Int       @unique
  title     String
  subject   String
  content   String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  logs      DripLog[]

  @@index([createdAt])
  @@map("drip_campaigns")
}

model DripLog {
  id         String       @id @default(cuid())
  tenantId   String
  campaignId String
  sentAt     DateTime     @default(now())
  isOpened   Boolean      @default(false)
  openedAt   DateTime?
  isClicked  Boolean      @default(false)
  clickedAt  DateTime?
  campaign   DripCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, campaignId])
  @@index([tenantId])
  @@index([tenantId, sentAt(sort: Desc)])
  @@map("drip_logs")
}

model Office {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  slug           String
  description    String?
  imageUrl       String?
  category       String?
  type           String?
  access         String?
  operatingHours String?
  mapUrl         String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, sortOrder])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("offices")
}

model Service {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  imageUrl    String?
  category    String?
  pricing     String?
  icon        String?
  features    Json?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, sortOrder])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("services")
}

model Testimonial {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  role        String   @default("Customer")
  company     String?
  testimonial String?
  imageUrl    String?
  linkedin    String?
  rating      Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("testimonials")
}

model TeamMember {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  position   String
  department String?
  imageUrl   String?
  bio        String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  email      String?
  phone      String?
  instagram  String?
  facebook   String?
  linkedin   String?
  twitter    String?
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, sortOrder])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("team_members")
}

model Popup {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  content     String?
  imageUrl    String?
  videoUrl    String?
  buttonText  String?
  buttonLink  String?
  isActive    Boolean  @default(false)
  displayOnce Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("popups")
}

model Slider {
  id         String   @id @default(cuid())
  tenantId   String
  title      String?
  subtitle   String?
  imageUrl   String
  buttonText String?
  buttonLink String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("sliders")
}

model SubscriptionPlan {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  price           Float          @default(0)
  interval        String         @default("MONTHLY")
  features        Json?
  maxTeamMembers  Int            @default(0)
  maxStorage      Int            @default(0)
  monthlyAiTokens Int            @default(0)
  isActive        Boolean        @default(true)
  isPopular       Boolean        @default(false)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
  tenants         Tenant[]

  @@index([createdAt])
  @@map("subscription_plans")
}

model Subscription {
  id        String           @id @default(cuid())
  tenantId  String
  planId    String
  paymentId String?          @unique
  status    String           @default("ACTIVE")
  startDate DateTime         @default(now())
  endDate   DateTime?
  amount    Float            @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  payment   Payment?         @relation(fields: [paymentId], references: [id])
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("subscriptions")
}

model AffiliateProfile {
  id                 String                @id @default(cuid())
  userId             String                @unique
  referralCode       String                @unique
  bankName           String?
  bankAccount        String?
  accountName        String?
  balance            Int                   @default(0)
  totalEarnings      Int                   @default(0)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  clicks             Int                   @default(0)
  commissions        AffiliateCommission[]
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals        AffiliateWithdrawal[]
  tenantApplications TenantApplication[]
  discountCodes      DiscountCode[]

  @@index([createdAt])
  @@map("affiliate_profiles")
}

model AffiliateCommission {
  id          String           @id @default(cuid())
  affiliateId String
  tenantId    String
  paymentId   String
  amount      Int
  status      String           @default("PENDING")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
